#!/bin/sh
# 兜底：WiFi 网卡枚举晚于首启脚本时自动补配（幂等，配好后直接跳过）。
# 判定标准改为 wlan_sta（STA 自动上联是本固件的核心功能，AP 可缺）。
[ "$ACTION" = "add" ] || exit 0
[ -f /etc/config/wireless ] && grep -q "wlan_sta" /etc/config/wireless 2>/dev/null && exit 0

/sbin/wifi config >/dev/null 2>&1
uci -q get wireless.radio0 >/dev/null 2>&1 || exit 0

# 与 99-hk1-firstboot 保持一致：2.4G ch1 + STA 连小米子路由 + 热点 HK1Box
uci set wireless.radio0.channel='1'
uci set wireless.radio0.htmode='HT20'
uci set wireless.radio0.country='CN'
uci set wireless.radio0.disabled='0'

uci -q delete wireless.wlan_sta
uci set wireless.wlan_sta=wifi-iface
uci set wireless.wlan_sta.device='radio0'
uci set wireless.wlan_sta.mode='sta'
uci set wireless.wlan_sta.network='wwan'
uci set wireless.wlan_sta.ssid='Xiaomi_子路由'
uci set wireless.wlan_sta.encryption='psk2'
uci set wireless.wlan_sta.key='xiaochangtongzhitiaoshizimuluyouqi'
uci set wireless.wlan_sta.disabled='0'

uci set wireless.default_radio0.ssid='HK1Box'
uci set wireless.default_radio0.encryption='psk2'
uci set wireless.default_radio0.key='12345678'
uci set wireless.default_radio0.network='lan'
uci set wireless.default_radio0.disabled='0'

uci commit wireless

# wwan 静态上联 + 防火墙兜底（若首启脚本已配，uci 会覆盖成相同值，幂等）
uci -q delete network.wwan
uci set network.wwan=interface
uci set network.wwan.proto='static'
uci set network.wwan.ipaddr='192.168.1.48'
uci set network.wwan.netmask='255.255.255.0'
uci set network.wwan.gateway='192.168.1.1'
uci add_list network.wwan.dns='223.5.5.5'
uci add_list network.wwan.dns='119.29.29.29'
uci set network.wwan.metric='20'
uci commit network
for Z in $(uci -q show firewall | sed -n 's/^\(firewall\.[^.]*\)=zone$/\1/p'); do
  if [ "$(uci -q get $Z.name)" = "wan" ]; then
    uci -q del_list $Z.network='wwan'
    uci add_list $Z.network='wwan'
    break
  fi
done
uci commit firewall

chmod 0777 /var/run 2>/dev/null

/sbin/wifi up >/dev/null 2>&1
exit 0
