# ===== 目标平台：ImmortalWrt 23.05 armsr/armv8（供 ophub 封装成 HK1 Box 镜像，内核 5.15）=====
# 选 23.05 / 5.15 的原因：OAF 内核模块(kmod-oaf)对老内核适配最好。
# 注意：封装时 ophub 会删掉本 rootfs 的 /lib/modules 并换成它自己的内核(5.15.222-ophub)，
# 所以这里的 kmod-* 主要作用是提供 /etc/modules.d/* 自动加载表（模块本体由 ophub 提供），
# 而 oaf.ko 由封装流程用 ophub 内核头文件重新编译后注入（见 inject-oaf.sh）。
CONFIG_TARGET_armsr=y
CONFIG_TARGET_armsr_armv8=y
CONFIG_TARGET_ROOTFS_TARGZ=y

# rootfs 体积较大（含 Docker，未压缩约 287MB），armsr 默认 rootfs 分区只有 160MiB，
# 会导致 ext4 镜像生成失败："ext4_allocate_best_fit_partial: failed to allocate ... out of space"。
# 加大到 1024MiB（armsr 有 rootfs-part 特性，此配置项有效）。
CONFIG_TARGET_ROOTFS_PARTSIZE=1024

# ===== Docker 容器 =====
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_kmod-br-netfilter=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-bridge=y

# ===== LuCI 基础与中文 =====
CONFIG_PACKAGE_luci=y
# 注：不勾 luci-ssl / wget-ssl，避免 libustream-openssl 与 mbedtls 的 libustream-ssl.so 抢文件导致打包中止。
#     HTTPS 下载用 curl（自带 openssl，不走 libustream）即可。
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-dockerman-zh-cn=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-samba4=y

# ===== OAF (OpenAppFilter) 家长控制 / 应用识别 =====
# wshcxl/Open-App 提供：kmod-oaf(oaf.ko) + appfilter(守护进程 oafd) + luci-app-oaf(界面)
# luci-app-oaf 会自动 select 下面两个；这里显式写出以防万一。
CONFIG_PACKAGE_luci-app-oaf=y
CONFIG_PACKAGE_appfilter=y
CONFIG_PACKAGE_kmod-oaf=y

# ===== 网络监控（按设备/IP 统计流量，与 OAF 的应用识别互补）=====
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_nlbwmon=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y

# ===== 常用工具 =====
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_tcpdump=y

# ===== WiFi（HK1 Box 自带 brcm4339 SDIO 无线网卡）=====
# 驱动本体(brcmfmac.ko)和固件由 ophub 提供（ophub/firmware 里有 brcmfmac4339-sdio.bin
# 以及 sm1 板子专用的 brcmfmac4339-sdio.amlogic,sm1.txt），所以这里只要用户态：
#   kmod-brcmfmac → 生成 /etc/modules.d/brcmfmac，开机才会去加载驱动
#   wpad-mbedtls  → hostapd+wpa_supplicant（开 AP / 连 WiFi 必须，缺了 WiFi 完全用不了）
#   iw / wireless-regdb → 常规配套
# 如果不需要 WiFi，把这一段删掉即可。
CONFIG_PACKAGE_kmod-brcmfmac=y
CONFIG_PACKAGE_wpad-mbedtls=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_wireless-regdb=y
