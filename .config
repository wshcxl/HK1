# ===== 目标平台：ImmortalWrt 23.05 armsr/armv8（供 ophub 封装成 HK1 Box 镜像，内核 5.15）=====
# 选 23.05 / 5.15 的原因：OAF 内核模块(kmod-oaf)对老内核适配最好，且 ophub 封装用的 Flippy 5.15.y
# 与 23.05 的 5.15.x 同系列，vermagic 最可能对得上，oaf.ko 才能正常加载。
CONFIG_TARGET_armsr=y
CONFIG_TARGET_armsr_armv8=y
CONFIG_TARGET_ROOTFS_TARGZ=y

# ===== Docker 容器 =====
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_kmod-br-netfilter=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-bridge=y

# ===== LuCI 基础与中文 =====
CONFIG_PACKAGE_luci=y
# 注：不勾 luci-ssl / wget-ssl，避免 libustream-openssl 与 mbedtls 的 libustream-ssl.so 抢文件导致打包中止。
#     HTTPS 下载用 curl（自带 openssl，不走 libustream）即可。
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-dockerman-zh-cn=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-samba4=y

# ===== OAF (OpenAppFilter) 家长控制 / 应用识别 =====
# wshcxl/Open-App 提供：kmod-oaf(oaf.ko) + appfilter(守护进程 oafd) + luci-app-oaf(界面)
# luci-app-oaf 会自动 select 下面两个；这里显式写出以防万一。
CONFIG_PACKAGE_luci-app-oaf=y
CONFIG_PACKAGE_appfilter=y
CONFIG_PACKAGE_kmod-oaf=y

# ===== 常用工具 =====
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_tcpdump=y
